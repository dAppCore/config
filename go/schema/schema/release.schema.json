{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": { "type": "integer" },
    "archive": {
      "type": "object",
      "properties": {
        "format": { "type": "string" },
        "include": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "checksums": { "type": "boolean" },
    "github": {
      "type": "object",
      "properties": {
        "draft": { "type": "boolean" },
        "prerelease": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "changelog": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
