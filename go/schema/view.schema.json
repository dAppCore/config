{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": { "type": ["integer", "string"] },
    "code": { "type": "string" },
    "name": { "type": "string" },
    "sign": { "type": "string" },
    "title": { "type": "string" },
    "width": { "type": "integer", "minimum": 0 },
    "height": { "type": "integer", "minimum": 0 },
    "resizable": { "type": "boolean" },
    "layout": { "type": "string" },
    "slots": {
      "type": "object",
      "additionalProperties": true
    },
    "modules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "clipboard": { "type": "boolean" },
        "filesystem": { "type": "boolean" },
        "network": { "type": "boolean" },
        "notifications": { "type": "boolean" },
        "camera": { "type": "boolean" },
        "microphone": { "type": "boolean" },
        "read": {
          "type": "array",
          "items": { "type": "string" }
        },
        "net": {
          "type": "array",
          "items": { "type": "string" }
        },
        "run": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
