{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer"
    },
    "app": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "dev": {
      "type": "object",
      "properties": {
        "editor": { "type": "string" },
        "language": { "type": "string" }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
